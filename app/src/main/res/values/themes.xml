<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- AOD Studio uses Compose for theming, but we need a base XML theme
         for the splash/startup and the Activity window background. -->
    <style name="Base.Theme.AODStudio" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Pure black background for AMOLED -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.AODStudio" parent="Base.Theme.AODStudio" />
</resources>
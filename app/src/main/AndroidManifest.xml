<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Core overlay & display permissions ───────────────────────── -->
    <!-- SYSTEM_ALERT_WINDOW: TYPE_APPLICATION_OVERLAY for AOD rendering (granted via Settings) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- WAKE_LOCK: required for SCREEN_DIM_WAKE_LOCK to prevent display STATE_OFF -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ── Foreground service permissions ───────────────────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: FOREGROUND_SERVICE_SPECIAL_USE required for specialUse type -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ── Battery & power ──────────────────────────────────────────── -->
    <!-- Baseline AOSP battery optimization exemption. NOTE: insufficient alone on OriginOS —
         the Vivo-specific whitelist (iManager autostart + Battery High Background) is also mandatory. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Auto-start AOD service after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground service notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AODStudioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AODStudio"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AODStudio"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Lock Screen AOD Activity ──────────────────────────────── -->
        <!--
            android:showWhenLocked="true" and android:turnScreenOn="true" are required on API 27+
            to allow this Activity to render ABOVE the system keyguard when the device is locked.
        -->
        <activity
            android:name=".aod.ui.AODActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.AODStudio"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density|fontScale" />

        <!-- ── AOD Foreground Service ────────────────────────────────── -->
        <!--
            foregroundServiceType="specialUse" required on Android 14+.
            Play Store justification: "always-on-display screen rendering — keeps a
            low-brightness overlay visible when the screen would normally power off,
            simulating system AOD on devices where Display.STATE_DOZE is unavailable
            to third-party apps."
        -->
        <service
            android:name=".aod.service.AODForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <!-- Justification property required by Play Store review for specialUse type -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="always-on-display screen rendering" />
        </service>

        <!-- ── ServiceWatchdog ───────────────────────────────────────── -->
        <!--
            AlarmManager-based watchdog that restarts AODForegroundService when OriginOS kills it
            from recents. Triggered via onTaskRemoved() → setExactAndAllowWhileIdle.
            NOT exported — only this app's AlarmManager PendingIntents fire it.
        -->
        <receiver
            android:name=".aod.lifecycle.ServiceWatchdog"
            android:exported="false" />

        <!-- ── Notification Listener Service ────────────────────────── -->
        <service
            android:name=".notification.service.AODNotificationListenerService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ── Boot Receiver ─────────────────────────────────────────── -->
        <receiver
            android:name=".aod.lifecycle.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>